# Copy to .env.release (gitignored) or export these variables.
# Never commit a keystore or its passwords.

TIKU_RELEASE_KEYSTORE="$HOME/keys/tiku-prompt-release.jks"
TIKU_RELEASE_KEY_ALIAS="tiku-prompt"
TIKU_RELEASE_KEYSTORE_PASSWORD=""
TIKU_RELEASE_KEY_PASSWORD=""
# SHA-256 fingerprint of the release certificate, lowercase hex.
TIKU_RELEASE_CERT_SHA256=""

# Only for GitHub release uploads. Use a token owned by pchartming.
# Prefer exporting this in the shell rather than storing it in a file.
# GH_TOKEN=""

# Optional paths; defaults are JDK 17 and Android SDK build-tools 35.0.0.
# TIKU_RELEASE_JDK="/path/to/jdk17"
# TIKU_RELEASE_APKSIGNER="/path/to/build-tools/35.0.0/apksigner"
# TIKU_RELEASE_ZIPALIGN="/path/to/build-tools/35.0.0/zipalign"
# TIKU_RELEASE_AAPT2="/path/to/build-tools/35.0.0/aapt2"
# TIKU_RELEASE_NOTES_FILE="docs/releases/v0.1.0.md"
